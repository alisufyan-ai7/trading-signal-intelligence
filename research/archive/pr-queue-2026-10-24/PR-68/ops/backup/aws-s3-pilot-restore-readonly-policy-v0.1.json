{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPilotObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::vowsig-backup-s3-2026/pilot/*"
    },
    {
      "Sid": "ListOnlyPilotPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::vowsig-backup-s3-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pilot/",
            "pilot/*"
          ]
        }
      }
    }
  ]
}
