# MT5 credentials remain configured in the local terminal; do not commit secrets.
#
# Telegram beta alerts. Keep actual values only in local .env / secrets manager.
TRADINGTOP_TELEGRAM_BOT_TOKEN=
TRADINGTOP_TELEGRAM_CHAT_ID=

# Cloud derived-snapshot ingestion.
# VPS/Windows collector:
TRADINGTOP_INGEST_URL=https://tradingtop-early-access-production.up.railway.app/api/internal/snapshot
TRADINGTOP_INGEST_TOKEN=

# Cloud app storage path. Railway/container deployments use this path.
TRADINGTOP_SNAPSHOT_PATH=/data/public_snapshot.json

# SignalProof AI-v1 inference provider.
# Keep the actual key only in the local VPS .env / process environment.
OPENAI_API_KEY=


# Early Access feedback/customer discovery.
# Cloud app stores feedback on the persistent Railway volume.
SIGNALPROOF_FEEDBACK_DB_PATH=/data/feedback.sqlite

# Dedicated owner-only feedback summary/export bearer secret.
# Do NOT reuse TRADINGTOP_INGEST_TOKEN. Keep the actual value only in Railway/local secrets.
SIGNALPROOF_FEEDBACK_OWNER_TOKEN=


# ----------------------------------------------------------
# VowSig authenticated Free-member and owner web candidate.
# EXAMPLE NAMES ONLY — do not paste real credentials into Git.
# Actual Railway envs are isolated (staging vs production), and variables
# may stay STAGED / NOT DEPLOYED until exact-SHA owner release approval.
# These default OFF intentionally; do not activate partially.
# Full matrix: docs/vowsig-railway-zero-to-production-rebuild-runbook.md
# ----------------------------------------------------------
VOWSIG_ACCOUNTS_FOUNDATION_ENABLED=0
VOWSIG_OIDC_AUTH_ENABLED=0
VOWSIG_ACCOUNTS_APP_ORIGIN=
# App user ONLY (vowsig_app), private Railway hostname, sslmode=verify-full
# and environment-specific pinned public CA packaged under /app/config/tls.
VOWSIG_ACCOUNTS_DATABASE_URL=
# High entropy, private, separate per environment.
VOWSIG_ACCOUNTS_CSRF_SECRET=
# Exact provider discovery settings; preserve trailing slash on issuer.
VOWSIG_OIDC_ISSUER=
VOWSIG_OIDC_CLIENT_ID=
VOWSIG_OIDC_AUTHORIZATION_ENDPOINT=
VOWSIG_OIDC_TOKEN_ENDPOINT=
VOWSIG_OIDC_JWKS_URI=
# Existing Auth0 Regular Web App confidential client secret.
VOWSIG_OIDC_CLIENT_SECRET=
# Canonical base64url (43 chars) of 32 random bytes, distinct per env;
# must be preserved with owner MFA encrypted data / recovery custody.
VOWSIG_OWNER_TOTP_MASTER_KEY_B64=
