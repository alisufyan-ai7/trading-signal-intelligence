{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "decision",
    "raw_confidence",
    "regime",
    "stop_atr",
    "tp1_r",
    "tp2_r",
    "rationale",
    "supporting_factors",
    "risk_factors"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["AI-v1.0"]
    },
    "decision": {
      "type": "string",
      "enum": ["BUY", "SELL", "NO_TRADE"]
    },
    "raw_confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "regime": {
      "type": "string",
      "enum": [
        "TREND_UP",
        "TREND_DOWN",
        "RANGE",
        "VOLATILE",
        "MIXED",
        "UNCLEAR"
      ]
    },
    "stop_atr": {
      "type": ["number", "null"],
      "minimum": 1.0,
      "maximum": 3.0
    },
    "tp1_r": {
      "type": ["number", "null"],
      "minimum": 0.75,
      "maximum": 2.0
    },
    "tp2_r": {
      "type": ["number", "null"],
      "minimum": 1.5,
      "maximum": 4.0
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "supporting_factors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "risk_factors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  }
}
