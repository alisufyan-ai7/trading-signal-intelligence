# MT5 credentials remain configured in the local terminal; do not commit secrets.
#
# Telegram beta alerts. Keep actual values only in local .env / secrets manager.
TRADINGTOP_TELEGRAM_BOT_TOKEN=
TRADINGTOP_TELEGRAM_CHAT_ID=

# Cloud derived-snapshot ingestion.
# VPS/Windows collector:
TRADINGTOP_INGEST_URL=https://tradingtop-early-access-production.up.railway.app/api/internal/snapshot
TRADINGTOP_INGEST_TOKEN=

# Cloud app storage path. Railway/container deployments use this path.
TRADINGTOP_SNAPSHOT_PATH=/data/public_snapshot.json

# SignalProof AI-v1 inference provider.
# Keep the actual key only in the local VPS .env / process environment.
OPENAI_API_KEY=


# Early Access feedback/customer discovery.
# Cloud app stores feedback on the persistent Railway volume.
SIGNALPROOF_FEEDBACK_DB_PATH=/data/feedback.sqlite

# Dedicated owner-only feedback summary/export bearer secret.
# Do NOT reuse TRADINGTOP_INGEST_TOKEN. Keep the actual value only in Railway/local secrets.
SIGNALPROOF_FEEDBACK_OWNER_TOKEN=
