# MT5 credentials remain configured in the local terminal; do not commit secrets.
#
# Early Access invite gate. If both are set, the web app requires HTTP Basic auth.
TRADINGTOP_BETA_USER=
TRADINGTOP_BETA_PASSWORD=

# Telegram beta alerts. Keep actual values only in local .env / secrets manager.
TRADINGTOP_TELEGRAM_BOT_TOKEN=
TRADINGTOP_TELEGRAM_CHAT_ID=

# Cloud derived-snapshot ingestion.
# Example URL: https://your-beta-host.example/api/internal/snapshot
TRADINGTOP_INGEST_URL=
TRADINGTOP_INGEST_TOKEN=

# Cloud app storage path. Railway/container deployments should use a persistent volume.
TRADINGTOP_SNAPSHOT_PATH=
