{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vowsig.local/schemas/ai-v1.2-expansion-feature-snapshot.json",
  "title": "VowSig AI-v1.2 expansion feature snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_schema_version",
    "source_symbol",
    "canonical_symbol",
    "source_bar_open_utc",
    "source_bar_close_utc",
    "inference_started_utc",
    "data_age_seconds",
    "close_h1",
    "ret_1",
    "ret_4",
    "ret_12",
    "ret_24",
    "atr_14",
    "atr_percentile_252",
    "price_vs_ema20_h1_atr",
    "price_vs_ema50_h1_atr",
    "ema20_slope_h1",
    "ema50_slope_h1",
    "price_vs_ema20_h4_atr",
    "price_vs_ema50_h4_atr",
    "ema20_slope_h4",
    "ema50_slope_h4",
    "rsi_14",
    "range_position_20",
    "distance_prior20_high_atr",
    "distance_prior20_low_atr",
    "distance_previous_day_high_atr",
    "distance_previous_day_low_atr",
    "previous_day_utc",
    "tr_expansion_ratio",
    "volume_z_20",
    "return_sign_agreement",
    "volatility_regime",
    "trend_regime",
    "session_bucket",
    "utc_hour",
    "utc_day_of_week",
    "spread_price",
    "spread_atr_fraction",
    "quality_flags"
  ],
  "properties": {
    "feature_schema_version": {"const": "AI-v1.0"},
    "source_symbol": {"type": "string", "enum": ["EURUSD", "XAGUSD", "USOIL"]},
    "canonical_symbol": {"type": "string", "minLength": 1},
    "source_bar_open_utc": {"type": "string"},
    "source_bar_close_utc": {"type": "string"},
    "inference_started_utc": {"type": "string"},
    "data_age_seconds": {"type": "number", "minimum": 0},
    "close_h1": {"type": "number"},
    "ret_1": {"type": "number"},
    "ret_4": {"type": "number"},
    "ret_12": {"type": "number"},
    "ret_24": {"type": "number"},
    "atr_14": {"type": "number", "exclusiveMinimum": 0},
    "atr_percentile_252": {"type": "number", "minimum": 0, "maximum": 1},
    "price_vs_ema20_h1_atr": {"type": "number"},
    "price_vs_ema50_h1_atr": {"type": "number"},
    "ema20_slope_h1": {"type": "number"},
    "ema50_slope_h1": {"type": "number"},
    "price_vs_ema20_h4_atr": {"type": "number"},
    "price_vs_ema50_h4_atr": {"type": "number"},
    "ema20_slope_h4": {"type": "number"},
    "ema50_slope_h4": {"type": "number"},
    "rsi_14": {"type": "number", "minimum": 0, "maximum": 100},
    "range_position_20": {"type": "number"},
    "distance_prior20_high_atr": {"type": "number"},
    "distance_prior20_low_atr": {"type": "number"},
    "distance_previous_day_high_atr": {"type": "number"},
    "distance_previous_day_low_atr": {"type": "number"},
    "previous_day_utc": {"type": "string"},
    "tr_expansion_ratio": {"type": "number", "minimum": 0},
    "volume_z_20": {"type": "number"},
    "return_sign_agreement": {"type": "string", "enum": ["ALL_UP", "ALL_DOWN", "MIXED"]},
    "volatility_regime": {"type": "string", "enum": ["LOW", "NORMAL", "HIGH"]},
    "trend_regime": {"type": "string", "enum": ["TREND_UP", "TREND_DOWN", "RANGE", "MIXED"]},
    "session_bucket": {"type": "string", "enum": ["ASIA", "LONDON", "NEW_YORK", "LATE"]},
    "utc_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "utc_day_of_week": {"type": "integer", "minimum": 0, "maximum": 6},
    "spread_price": {"type": "number", "minimum": 0},
    "spread_atr_fraction": {"type": "number", "minimum": 0},
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  }
}
