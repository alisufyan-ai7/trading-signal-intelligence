{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalproof.local/schemas/ai-v1.1-activation.json",
  "title": "SignalProof AI-v1.1 runtime activation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_version",
    "decision_protocol_version",
    "market",
    "activated_at_utc",
    "repository_commit_sha",
    "activation_bundle_sha256",
    "supersedes_runtime_version",
    "upstream_activation_anchor",
    "upstream_activation_anchor_sha256",
    "gate_counts_carry_forward",
    "backfill_prior_missed",
    "provider",
    "model_id",
    "model_parameter_fingerprint",
    "policy_sha256",
    "feature_definitions_sha256",
    "feature_schema_sha256",
    "decision_schema_sha256",
    "guardrails_sha256",
    "feature_builder_source_sha256",
    "inference_adapter_source_sha256",
    "provider_neutral_inference_source_sha256",
    "contract_source_sha256",
    "guard_source_sha256",
    "ai_ledger_source_sha256",
    "lifecycle_evaluator_source_sha256",
    "cost_policy_fingerprint",
    "sync_max_wait_seconds",
    "sync_poll_interval_seconds",
    "broker_execution_enabled"
  ],
  "properties": {
    "runtime_version": {"const": "AI-v1.1"},
    "decision_protocol_version": {"const": "AI-v1.0"},
    "market": {"type": "string", "enum": ["XAUUSD", "USTEC", "US30"]},
    "activated_at_utc": {"type": "string"},
    "repository_commit_sha": {"type": "string", "minLength": 40, "maxLength": 40},
    "activation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supersedes_runtime_version": {"const": "AI-v1.0"},
    "upstream_activation_anchor": {"type": "string", "minLength": 1},
    "upstream_activation_anchor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_counts_carry_forward": {"const": false},
    "backfill_prior_missed": {"const": false},
    "provider": {"const": "openai"},
    "model_id": {"const": "gpt-5.4-2026-03-05"},
    "model_parameter_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_definitions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guardrails_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_builder_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inference_adapter_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_neutral_inference_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guard_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ai_ledger_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_evaluator_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sync_max_wait_seconds": {"const": 30.0},
    "sync_poll_interval_seconds": {"const": 1.0},
    "broker_execution_enabled": {"const": false}
  }
}
